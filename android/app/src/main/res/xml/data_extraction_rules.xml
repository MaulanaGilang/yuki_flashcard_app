<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+: back up only progress (cards, review log, settings). Packs are re-installable. -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="database" path="progress.db" />
        <include domain="database" path="progress.db-wal" />
        <include domain="database" path="progress.db-shm" />
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="progress.db" />
        <include domain="database" path="progress.db-wal" />
        <include domain="database" path="progress.db-shm" />
    </device-transfer>
</data-extraction-rules>
